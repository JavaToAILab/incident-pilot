<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.javatoailab</groupId>
        <artifactId>incident-pilot</artifactId>
        <version>0.6.0</version>
    </parent>

    <artifactId>prompt-contracts</artifactId>
    <name>prompt-contracts</name>
    <description>Versioned, immutable prompt templates with declared inputs, a lock file and traceable prompt refs (Article 6)</description>

    <dependencies>
        <dependency>
            <groupId>io.github.javatoailab</groupId>
            <artifactId>llm-client</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.javatoailab</groupId>
            <artifactId>context-budget</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.github.javatoailab.incidentpilot.prompt.PromptReport</mainClass>
                    <!-- exec:java runs inside Maven's JVM, whose working directory is wherever mvn was
                         launched (usually the repo root), so pass the module's prompt folder explicitly. -->
                    <systemProperties>
                        <systemProperty>
                            <key>prompts.dir</key>
                            <value>${project.basedir}/src/main/resources/prompts</value>
                        </systemProperty>
                    </systemProperties>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
